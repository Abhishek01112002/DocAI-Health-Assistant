<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/footerNavigation"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Header -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DoCAI"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DoCAI Health App"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#87CEEB"
                android:layout_gravity="center"
                android:layout_marginBottom="32dp" />

            <!-- Google Fit Connection -->
            <Button
                android:id="@+id/btnConnectGoogleFit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="CONNECT TO GOOGLE FIT"
                android:textColor="#FFFFFF"
                android:background="@drawable/button_blue"
                android:layout_marginBottom="32dp" />

            <!-- Fetch Health Data -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Fetch Health Data:"
                android:textSize="16sp"
                android:textColor="#FFFFFF"
                android:layout_gravity="center"
                android:layout_marginBottom="16dp" />

            <Button
                android:id="@+id/btnFetchSteps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="FETCH STEPS"
                android:textColor="#FFFFFF"
                android:background="@drawable/button_purple"
                android:layout_marginBottom="8dp" />

            <Button
                android:id="@+id/btnFetchHeartRate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="FETCH HEART RATE"
                android:textColor="#FFFFFF"
                android:background="@drawable/button_purple"
                android:layout_marginBottom="8dp" />

            <Button
                android:id="@+id/btnFetchCalories"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="FETCH CALORIES"
                android:textColor="#FFFFFF"
                android:background="@drawable/button_purple"
                android:layout_marginBottom="8dp" />

            <Button
                android:id="@+id/btnFetchDistance"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="FETCH DISTANCE"
                android:textColor="#FFFFFF"
                android:background="@drawable/button_purple"
                android:layout_marginBottom="16dp" />

            <Button
                android:id="@+id/btnFetchAllData"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="FETCH ALL HEALTH DATA"
                android:textColor="#FFFFFF"
                android:background="@drawable/button_orange"
                android:layout_marginBottom="32dp" />

        </LinearLayout>

    </ScrollView>

    <!-- Fixed Footer Navigation -->
    <LinearLayout
        android:id="@+id/footerNavigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="#F5F5F5"
        android:padding="8dp"
        android:elevation="8dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="8dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_home"
                android:tint="#666666" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Home"
                android:textSize="12sp"
                android:textColor="#666666"
                android:layout_marginTop="4dp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="8dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_document"
                android:tint="#666666" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Consultancy"
                android:textSize="12sp"
                android:textColor="#666666"
                android:layout_marginTop="4dp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="8dp"
            android:background="@drawable/selected_tab_background">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_clock"
                android:tint="#2196F3" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Device"
                android:textSize="12sp"
                android:textColor="#2196F3"
                android:layout_marginTop="4dp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="8dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_fork_knife"
                android:tint="#666666" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Diet Plan"
                android:textSize="12sp"
                android:textColor="#666666"
                android:layout_marginTop="4dp" />

        </LinearLayout>

    </LinearLayout>

</RelativeLayout>
